# ==============================================================================
# TrueVoice MVP Backend Configuration
# ==============================================================================

# Project & Runtime Info
PROJECT_NAME="TrueVoice"
VERSION="1.2.0"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"

# ML Execution Mode:
# "mock": Deterministic fast simulated models for CI, unit testing, and dev without GPU
# "live": Full resident deep learning pipelines (requires PyTorch / SpeechBrain / Whisper)
TRUEVOICE_ML_MODE="mock"

# Security & Cryptography
# IMPORTANT: Generate a strong 256-bit random key in production (e.g. `openssl rand -hex 32`)
SECRET_KEY="truevoice-dev-insecure-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=15
WS_TOKEN_EXPIRE_MINUTES=5

# Primary Relational & Vector Database
DATABASE_URL="postgresql+asyncpg://truevoice:truevoice@localhost:5432/truevoice_db"

# Optional Redis Pub/Sub
# REDIS_URL="redis://localhost:6379/0"

# Audio Pipeline DSP Parameters
SAMPLE_RATE=16000
WINDOW_SECONDS=2.0
HOP_SECONDS=0.5
CHANNELS=1

# Model Architecture Configuration
DEEPFAKE_PRIMARY_DETECTOR="wav2vec2"  # wav2vec2, rawnet2, aasist, ensemble, mock
TRUEVOICE_ML_DEVICE="cpu"  # cpu or cuda
TRUEVOICE_WAV2VEC2_MODEL="MelodyMachine/Deepfake-audio-detection-V2"  # HuggingFace model id or local checkpoint
TRUEVOICE_RAWNET2_MODEL="/path/to/rawnet2_asvspoof2019.pth"  # RawNet2 checkpoint
TRUEVOICE_AASIST_MODEL="/path/to/AASIST.pth"  # AASIST / AASIST-L checkpoint
SPEAKER_VERIFIER_MODEL="ecapa"
ASR_MODEL="faster-whisper-tiny"
SPEAKER_COSINE_THRESHOLD=0.75

# Baseline Multi-Signal Fusion Weights (Must sum to 1.0)
WEIGHT_DEEPFAKE=0.35
WEIGHT_SPEAKER=0.25
WEIGHT_CONVERSATION=0.15
WEIGHT_CONTEXT=0.15
WEIGHT_FORENSIC=0.10

# Multi-Signal Compounding & Asymmetric EMA
GAMMA_MULTIPLIER=1.35
EMA_ATTACK_ALPHA=0.60
EMA_DECAY_ALPHA=0.20

# Declarative Policy Thresholds
CAUTION_THRESHOLD=30.0
VERIFY_THRESHOLD=60.0
BLOCK_THRESHOLD=80.0
SENSITIVE_AMOUNT_THRESHOLD=250000.0

# Secondary Verification
OOB_CHALLENGE_TTL_SECONDS=30
