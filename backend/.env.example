# ==============================================================================
# TrueVoice MVP Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your target environment.
# Local development values are pre-filled with safe defaults.
# Production/cloud credentials are intentionally left EMPTY and MUST be provided
# via a secure secrets manager (AWS Secrets Manager, GCP Secret Manager, Vault).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project & Runtime
# ------------------------------------------------------------------------------
PROJECT_NAME="TrueVoice"
VERSION="1.2.0"
ENVIRONMENT="development"               # "development" | "staging" | "production" | "test"
DEBUG=false                              # Set to true only during local debugging
LOG_LEVEL="INFO"                         # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ------------------------------------------------------------------------------
# 2. Server Networking & CORS
# ------------------------------------------------------------------------------
BACKEND_HOST="127.0.0.1"                 # Local bind address (use "0.0.0.0" in Docker/cloud)
BACKEND_PORT=8000                        # Uvicorn HTTP/WebSocket port
# Comma-separated list of allowed CORS origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 3. Machine Learning Execution Mode
# ------------------------------------------------------------------------------
# "mock": Fast deterministic simulations without heavy checkpoints (CI / tests / dev)
# "live": Full resident deep learning pipelines (requires PyTorch / SpeechBrain / faster-whisper)
TRUEVOICE_ML_MODE="mock"
TRUEVOICE_ML_DEVICE="cpu"                # "cpu" or "cuda"

# ------------------------------------------------------------------------------
# 4. Security & Cryptography
# ------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION: 256-bit cryptographically random secret key (e.g. `openssl rand -hex 32`)
# Cloud/production credential required; must not use the dev placeholder in production.
SECRET_KEY="truevoice-dev-insecure-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=15           # JWT REST API token lifetime
WS_TOKEN_EXPIRE_MINUTES=5                # Single-use WebSocket stream ticket TTL

# ------------------------------------------------------------------------------
# 5. Database & Caching
# ------------------------------------------------------------------------------
# Primary Relational & Vector Database (PostgreSQL 16 with pgvector extension)
# Local Docker default: postgresql+asyncpg://truevoice:truevoice@localhost:5432/truevoice_db
# Cloud/production: Leave empty or provide managed RDS/Cloud SQL connection string
DATABASE_URL="postgresql+asyncpg://truevoice:truevoice@localhost:5432/truevoice_db"

# Optional Redis Pub/Sub (For multi-instance session caching; leave empty for in-memory fallback)
REDIS_URL=

# ------------------------------------------------------------------------------
# 6. External Cloud Services - Brevo Email Service
# ------------------------------------------------------------------------------
# Cloud/external credential required; real key is not available and must not be fabricated.
# Populate these fields when connecting to Brevo (Sendinblue) transactional email API.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# ------------------------------------------------------------------------------
# 7. Audio Pipeline DSP Parameters
# ------------------------------------------------------------------------------
SAMPLE_RATE=16000                        # 16 kHz standard audio sampling rate
WINDOW_SECONDS=2.0                       # 2.0 second sliding window (32000 samples)
HOP_SECONDS=0.5                          # 0.5 second hop interval (8000 samples)
CHANNELS=1                               # Mono channel PCM16 audio

# ------------------------------------------------------------------------------
# 8. Model Architecture & Thresholds
# ------------------------------------------------------------------------------
DEEPFAKE_PRIMARY_DETECTOR="wav2vec2"     # "wav2vec2" | "rawnet2" | "aasist" | "ensemble" | "mock"
DEEPFAKE_SECONDARY_DETECTOR=
TRUEVOICE_WAV2VEC2_MODEL="MelodyMachine/Deepfake-audio-detection-V2"
TRUEVOICE_RAWNET2_MODEL=                 # Local checkpoint path (e.g. models/rawnet2.pth)
TRUEVOICE_AASIST_MODEL=                  # Local checkpoint path (e.g. models/AASIST.pth)

# ECAPA-TDNN Speaker Verification
SPEAKER_VERIFIER_MODEL="ecapa"
SPEAKER_MODEL_SOURCE="speechbrain/spkrec-ecapa-voxceleb"
TRUEVOICE_SPEAKER_THRESHOLD=0.75         # Similarity threshold in [0.0, 1.0]
TRUEVOICE_SPEAKER_DEVICE="cpu"           # "cpu" or "cuda"

# Faster-Whisper ASR
ASR_MODEL="faster-whisper-small"
TRUEVOICE_ASR_MODEL="small"              # tiny, base, small, medium, large-v3
TRUEVOICE_ASR_DEVICE="cpu"               # "cpu" or "cuda"
TRUEVOICE_ASR_COMPUTE_TYPE="int8"        # "int8", "float16", "float32"
TRUEVOICE_ASR_LANGUAGE=                  # Optional: "en", "hi", or leave empty for auto-detection
TRUEVOICE_ASR_BEAM_SIZE=5

# ------------------------------------------------------------------------------
# 9. Multi-Signal Fusion Engine (Weights must sum to 1.0)
# ------------------------------------------------------------------------------
WEIGHT_DEEPFAKE=0.35
WEIGHT_SPEAKER=0.25
WEIGHT_CONVERSATION=0.15
WEIGHT_CONTEXT=0.15
WEIGHT_FORENSIC=0.10

# Multi-Signal Compounding & Asymmetric EMA
GAMMA_MULTIPLIER=1.35                    # Non-linear multi-signal compounding exponent
EMA_ATTACK_ALPHA=0.60                    # Fast response to rising risk threats
EMA_DECAY_ALPHA=0.20                     # Conservative recovery on safe signals

# ------------------------------------------------------------------------------
# 10. Declarative Policy Engine Thresholds
# ------------------------------------------------------------------------------
CAUTION_THRESHOLD=30.0                   # Low-risk boundary (FLAG_MONITOR)
VERIFY_THRESHOLD=60.0                    # Medium-risk boundary (REQUIRE_OOB_VERIFY)
BLOCK_THRESHOLD=80.0                     # High-risk boundary (TERMINATE_CALL / BLOCK)
SENSITIVE_AMOUNT_THRESHOLD=250000.0      # ₹2.5 Lakh financial threshold

# Forensic Heuristic Baselines
FORENSIC_F0_STEP_HZ=50.0
FORENSIC_JITTER_MAX=0.002                # 0.2%
FORENSIC_SHIMMER_MAX=0.015               # 1.5%
FORENSIC_HNR_MIN_DB=15.0

# Secondary Verification (Out-of-Band Challenge)
OOB_CHALLENGE_TTL_SECONDS=30             # 30-second verification challenge window
