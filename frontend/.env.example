# ==============================================================================
# TrueVoice Frontend Environment Template
# ==============================================================================
# Copy this file to .env and adjust variables for your target environment.
# ==============================================================================

# Application Environment (development | staging | production)
VITE_APP_ENV=development
VITE_APP_NAME=TrueVoice

# Backend REST API Base URL
# Local Development: http://127.0.0.1:8000 (or leave empty to use Vite dev proxy)
# Production / Staging: specify the backend origin e.g. https://api.truevoice.bank.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend WebSocket Streaming Base URL
# Local Development: ws://127.0.0.1:8000 (or leave empty to use Vite dev proxy)
# Production / Staging: specify the WebSocket origin e.g. wss://api.truevoice.bank.com
VITE_WS_URL=ws://127.0.0.1:8000
